{
  "name": "autoship",
  "version": "0.2.0",
  "description": "CLI tool to automate changeset-based releases with AI-generated descriptions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "autoship": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "release",
    "changeset",
    "cli",
    "automation",
    "ai",
    "semver",
    "npm"
  ],
  "author": "Vercel Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/autoship.git"
  },
  "homepage": "https://github.com/vercel-labs/autoship#readme",
  "bugs": {
    "url": "https://github.com/vercel-labs/autoship/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "ai": "^7.0.22",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
